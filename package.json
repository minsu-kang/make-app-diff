{
  "name": "make-app-diff",
  "version": "1.7.4",
  "description": "Make.com app version diff viewer",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps && node node_modules/electron/install.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false --incremental false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false --incremental false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "electron-vite build && playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@electron-toolkit/utils": "4.0.0",
    "@monaco-editor/react": "4.7.0",
    "acorn": "8.16.0",
    "archiver": "7.0.1",
    "axios": "1.18.0",
    "diff": "5.2.2",
    "electron-store": "8.2.0",
    "monaco-editor": "0.55.1",
    "pkr": "2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/archiver": "7.0.0",
    "@types/diff": "5.2.3",
    "@types/node": "24.13.6",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.0.18",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "2.3.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "30.1.1",
    "nock": "14.0.17",
    "prettier": "3.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "5.4.21",
    "vitest": "4.0.18"
  },
  "build": {
    "appId": "com.make.app-diff",
    "productName": "MakeDiff",
    "icon": "resources/icon.icns",
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
